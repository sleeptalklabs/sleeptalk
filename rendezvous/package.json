{
  "name": "sleeptalk-rendezvous",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy:staging": "npm run build && wrangler deploy",
    "deploy:production": "npm run build && wrangler deploy --config wrangler.production.jsonc",
    "test": "vitest run --config vitest.config.ts && npm run test:worker",
    "test:worker": "vitest run --config vitest.worker.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@hpke/core": "1.9.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "^0.35.5"
  }
}
